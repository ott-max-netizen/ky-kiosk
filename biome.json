{
  "$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 110
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "files": {
    "includes": [
      "**",
      "!dist",
      "!edge-profile",
      "!node_modules",
      "!config.js",
      "!public/config.js",
      "!test-results",
      "!playwright-report",
      "!coverage",
      "!tests/e2e/snapshots"
    ]
  }
}
